+
+static void kbd_overlay_update(void) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (!g_win) return;
+        int show = g_kbd_overlay_enabled && !has_controller_connected();
+        if (show) {
+            if (!g_kbd_hud) kbd_overlay_create();
+            kbd_overlay_reposition();
+            [g_kbd_hud orderFront:nil];
+        } else {
+            if (g_kbd_hud) [g_kbd_hud orderOut:nil];
+        }
+        if (g_kbd_menu_item) {
+            g_kbd_menu_item.state = g_kbd_overlay_enabled ? NSControlStateValueOn : NSControlStateValueOff;
+        }
+    });
+}
+
+static void kbd_overlay_toggle(void) {
+    g_kbd_overlay_enabled = !g_kbd_overlay_enabled;
+    kbd_overlay_update();
+}

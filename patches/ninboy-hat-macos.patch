+static void apply_saved_choices(void) {
+    CFBundleRef b = CFBundleGetMainBundle(); if (!b) return;
+    CFArrayRef rules = (CFArrayRef)CFBundleGetValueForInfoDictionaryKey(b, CFSTR("DMSettings"));
+    CFStringRef domain = CFBundleGetIdentifier(b);
+    if (!rules || !domain || CFGetTypeID(rules) != CFArrayGetTypeID()) return;
+    for (CFIndex i = 0; i < CFArrayGetCount(rules); i++) {
+        CFTypeRef rule = CFArrayGetValueAtIndex(rules, i); char env[128], s[256];
+        if (CFGetTypeID(rule) != CFDictionaryGetTypeID()) continue;
+        CFTypeRef e = CFDictionaryGetValue((CFDictionaryRef)rule, CFSTR("env"));
+        if (!e || CFGetTypeID(e) != CFStringGetTypeID() || !CFStringGetCString((CFStringRef)e, env, sizeof env, kCFStringEncodingUTF8)) continue;
+        if (getenv(env)) continue;
+        CFStringRef key = CFStringCreateWithFormat(NULL, NULL, CFSTR("launcher.%s"), env);
+        CFPropertyListRef v = CFPreferencesCopyAppValue(key, domain); CFRelease(key);
+        if (!v) continue;
+        if (CFGetTypeID(v) == CFStringGetTypeID() && CFStringGetCString((CFStringRef)v, s, sizeof s, kCFStringEncodingUTF8)) {
